<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<properties>
		<revision>2.5.33-SNAPSHOT</revision>
		<repository>numworx.azurecr.io/</repository>
		<docker.platform>linux/amd64</docker.platform>
		<mysql.username>root</mysql.username>
		<mysql.password>test</mysql.password>
	</properties>
	<parent>
		<groupId>nl.uu.fi.dwo</groupId>
		<artifactId>DWO.master.pom</artifactId>
		<version>1.1</version>
	</parent>
	<artifactId>EBDocker</artifactId>
	<version>${revision}</version>
	<name>Docker voor EBServer</name>
	<dependencies>
		<dependency>
			<groupId>nl.uu.fi.dwo</groupId>
			<artifactId>EBServer</artifactId>
			<version>${project.version}</version>
			<type>war</type>
		</dependency>
		<dependency>
		  <groupId>nl.numworx.osiris</groupId>
  		  <artifactId>osiris-import</artifactId>
  		  <version>2.5.32</version>
  		  <type>war</type>
		</dependency>
		<dependency>
		    <groupId>de.javakaffee.msm</groupId>
		    <artifactId>memcached-session-manager-tc9</artifactId>
		    <version>2.3.2</version>
		</dependency>
		<dependency>
		    <groupId>nl.numworx.schoolyear</groupId>
		    <artifactId>sy</artifactId>
		    <version>2.5.32</version>
		    <type>war</type>
	        </dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>io.fabric8</groupId>
				<artifactId>docker-maven-plugin</artifactId>
				<version>0.43.4</version>
				<extensions>true</extensions>
		        <dependencies>
		            <dependency>
		                <groupId>com.amazonaws</groupId>
		                <artifactId>aws-java-sdk-core</artifactId>
		                <version>1.11.707</version>
		            </dependency>
		        </dependencies>
				<configuration>
					<images>
						<image>
							<alias>ebdocker</alias>
							<name>${repository}dwoproject:%l</name>
							<build>
						        <buildx>
						          <platforms>
						            <platform>${docker.platform}</platform>
						          </platforms>
						        </buildx>
								<dockerFileDir>${project.basedir}/src/main/docker</dockerFileDir>
								<assembly>
									<inline>
										<dependencySets>
											<dependencySet>
												<includes>
													<include>${project.groupId}:EBServer</include>
												</includes>
												<outputDirectory>.</outputDirectory>
												<outputFileNameMapping>ROOT.war</outputFileNameMapping>
											</dependencySet>
											<dependencySet>
												<includes>
													<include>nl.numworx.osiris:osiris-import</include>
												</includes>
												<outputDirectory>.</outputDirectory>
												<outputFileNameMapping>dwo#osiris-import.war</outputFileNameMapping>
											</dependencySet>
        <dependencySet>
	  <includes>
		<include>nl.numworx.schoolyear:sy</include>
	  </includes>
	  <outputDirectory>.</outputDirectory>
	  <outputFileNameMapping>sy.war</outputFileNameMapping>
	</dependencySet>
											<dependencySet>
												<includes>
													<include>de.javakaffee.msm:*</include>
													<include>net.spy:*</include>
												</includes>
												<outputDirectory>.</outputDirectory>
											</dependencySet>
										</dependencySets>
									</inline>
								</assembly>
							</build>
							<run>
								<ports>
									<port>127.0.0.1:8080:80</port>
									<port>127.0.0.1:8009:8009</port>
								</ports>
<!-- 								<volumes> -->
<!-- 									<bind> -->
<!-- 										<volume>${project.basedir}/target/dependency:/usr/local/tomcat/webapps</volume> -->
<!-- 									</bind> -->
<!-- 								</volumes> -->
								<links>
<!--									<link>mysql:mysql</link>-->
									<link>memcached:memcached</link>
								</links>
								<env>
									<RDS_PASSWORD>${mysql.password}</RDS_PASSWORD>
									<RDS_USERNAME>${mysql.username}</RDS_USERNAME>
									<RDS_DB_NAME>${mysql.database}</RDS_DB_NAME>
									<RDS_HOSTNAME>${mysql.host}</RDS_HOSTNAME>
									<DWO_REDIRECT>false</DWO_REDIRECT>
									<ENV_NOSEB>true</ENV_NOSEB>
									<UU_INDEX>/WEB-INF/uuindex.jsp</UU_INDEX>
<!--									<UU_DOWNLOAD>/WEB-INF/accdownload.html</UU_DOWNLOAD>-->
									<ENV_IPRANGE>172.17.0.1</ENV_IPRANGE>
									<MEMCACHED>test:memcached:11211</MEMCACHED>
									<ALLOW_ORIGIN>http://localhost:8080</ALLOW_ORIGIN>
									<DWO_ENV>testkiosk</DWO_ENV>
								</env>
								<labels>
									<traefik.frontend.rule>Host:app.docker.localhost</traefik.frontend.rule>
								</labels>
								<namingStrategy>alias</namingStrategy>
							</run>
						</image>
					</images>
				</configuration>
			</plugin>
		</plugins>
	</build>
	<packaging>docker-build</packaging>
	<profiles>
		<profile>
			<id>fresh</id>
			<properties>
				<docker.imagePullPolicy>always</docker.imagePullPolicy>			
			</properties>
		</profile>
		<profile>
			<id>arm64</id>
			<properties>
				<docker.platform>linux/arm64</docker.platform>
			</properties>
		</profile>
		<profile>
			<id>local</id>
			<properties>
				<docker.platform></docker.platform>
				<repository/>
			</properties>
		</profile>
		<profile>
			<id>aws</id>
			<properties>
				<repository>581490975307.dkr.ecr.eu-west-1.amazonaws.com/</repository>
			</properties>
		</profile>
	</profiles>
</project>
